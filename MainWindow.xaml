<Window x:Class="OhioNewsWeather.WeatherApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Ohio Weather - Ohio News and Weather"
        Height="900" Width="1600"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource PrimaryBrush}">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="WeatherPartlyCloudy"
                                           Width="32" Height="32"
                                           Foreground="White"
                                           VerticalAlignment="Center"/>
                    <TextBlock Text="Ohio Weather"
                             FontSize="24"
                             FontWeight="Bold"
                             Foreground="White"
                             Margin="15,0,0,0"
                             VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="Ohio News and Weather"
                         FontSize="14"
                         Foreground="White"
                         Opacity="0.9"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Navigation Sidebar -->
        <Border Grid.Row="1" Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,10">
                <Button x:Name="RadarButton"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Height="50"
                        HorizontalContentAlignment="Left"
                        Margin="5"
                        Click="RadarButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Radar" Width="24" Height="24" Margin="10,0"/>
                        <TextBlock Text="Radar" FontSize="16" VerticalAlignment="Center" Margin="10,0"/>
                    </StackPanel>
                </Button>

                <Button x:Name="SatelliteButton"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Height="50"
                        HorizontalContentAlignment="Left"
                        Margin="5"
                        Click="SatelliteButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Satellite" Width="24" Height="24" Margin="10,0"/>
                        <TextBlock Text="Satellite" FontSize="16" VerticalAlignment="Center" Margin="10,0"/>
                    </StackPanel>
                </Button>

                <Button x:Name="AlertsButton"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Height="50"
                        HorizontalContentAlignment="Left"
                        Margin="5"
                        Click="AlertsButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Alert" Width="24" Height="24" Margin="10,0"/>
                        <TextBlock Text="Alerts" FontSize="16" VerticalAlignment="Center" Margin="10,0"/>
                    </StackPanel>
                </Button>

                <Button x:Name="ConditionsButton"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Height="50"
                        HorizontalContentAlignment="Left"
                        Margin="5"
                        Click="ConditionsButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Thermometer" Width="24" Height="24" Margin="10,0"/>
                        <TextBlock Text="Conditions" FontSize="16" VerticalAlignment="Center" Margin="10,0"/>
                    </StackPanel>
                </Button>

                <Button x:Name="ExportButton"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Height="50"
                        HorizontalContentAlignment="Left"
                        Margin="5"
                        Click="ExportButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Export" Width="24" Height="24" Margin="10,0"/>
                        <TextBlock Text="Export" FontSize="16" VerticalAlignment="Center" Margin="10,0"/>
                    </StackPanel>
                </Button>

                <Separator Margin="10,20"/>

                <Button x:Name="SettingsButton"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Height="50"
                        HorizontalContentAlignment="Left"
                        Margin="5"
                        Click="SettingsButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Settings" Width="24" Height="24" Margin="10,0"/>
                        <TextBlock Text="Settings" FontSize="16" VerticalAlignment="Center" Margin="10,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Row="1" Grid.Column="1" Background="White" Margin="10">
            <Grid x:Name="ContentArea">
                <TextBlock Text="Welcome to Ohio Weather"
                         FontSize="32"
                         FontWeight="Light"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="#757575"/>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#E0E0E0" BorderBrush="#BDBDBD" BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <TextBlock x:Name="StatusText"
                         Text="Ready"
                         FontSize="12"
                         VerticalAlignment="Center"
                         Foreground="#616161"/>

                <TextBlock x:Name="LastUpdateText"
                         Text="Last Updated: --"
                         FontSize="12"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         Foreground="#616161"/>
            </Grid>
        </Border>
    </Grid>
</Window>

<UserControl x:Class="OhioNewsWeather.WeatherApp.Views.RadarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:OhioNewsWeather.WeatherApp.Views"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">
    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Control Bar -->
        <Border Grid.Row="0" Background="#2D2D2D" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Radar Site Selector -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="Radar Site:"
                             FontSize="14"
                             FontWeight="SemiBold"
                             Foreground="White"
                             VerticalAlignment="Center"
                             Margin="0,0,10,0"/>
                    <ComboBox x:Name="RadarSiteComboBox"
                            ItemsSource="{Binding RadarSites}"
                            SelectedItem="{Binding SelectedRadarSite, Mode=TwoWay}"
                            Width="200"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}"
                            materialDesign:TextFieldAssist.UnderlineBrush="White"
                            Foreground="White"
                            SelectionChanged="RadarSiteComboBox_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock>
                                        <Run Text="{Binding SiteId}" FontWeight="Bold"/>
                                        <Run Text=" - "/>
                                        <Run Text="{Binding Location}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Radar Product Selector -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Product:"
                             FontSize="14"
                             FontWeight="SemiBold"
                             Foreground="White"
                             VerticalAlignment="Center"
                             Margin="0,0,10,0"/>

                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ReflectivityButton"
                                   Content="Reflectivity"
                                   GroupName="RadarProduct"
                                   Style="{StaticResource MaterialDesignTabRadioButton}"
                                   Foreground="White"
                                   IsChecked="True"
                                   Margin="5,0"
                                   Click="ProductButton_Click"
                                   Tag="Reflectivity"/>
                        <RadioButton x:Name="VelocityButton"
                                   Content="Velocity"
                                   GroupName="RadarProduct"
                                   Style="{StaticResource MaterialDesignTabRadioButton}"
                                   Foreground="White"
                                   Margin="5,0"
                                   Click="ProductButton_Click"
                                   Tag="Velocity"/>
                        <RadioButton x:Name="CorrelationButton"
                                   Content="Correlation"
                                   GroupName="RadarProduct"
                                   Style="{StaticResource MaterialDesignTabRadioButton}"
                                   Foreground="White"
                                   Margin="5,0"
                                   Click="ProductButton_Click"
                                   Tag="CorrelationCoefficient"/>
                    </StackPanel>
                </StackPanel>

                <!-- Refresh Button -->
                <Button Grid.Column="3"
                      Content="Load Radar"
                      Command="{Binding LoadRadarCommand}"
                      Style="{StaticResource MaterialDesignRaisedButton}"
                      Background="#2196F3"
                      Foreground="White"
                      Height="35"
                      Padding="20,0"/>
            </Grid>
        </Border>

        <!-- Radar Display Area -->
        <Border Grid.Row="1" Background="Black" Margin="10">
            <Grid x:Name="RadarDisplayGrid">
                <!-- Zoom/Pan Container -->
                <ScrollViewer x:Name="RadarScrollViewer"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto"
                            Background="Black">
                    <Grid x:Name="RadarCanvasContainer">
                        <Image x:Name="RadarImage"
                             Source="{Binding CurrentFrame.Image}"
                             Stretch="Uniform"
                             RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.LayoutTransform>
                                <ScaleTransform x:Name="RadarScaleTransform"
                                              ScaleX="1"
                                              ScaleY="1"/>
                            </Image.LayoutTransform>
                        </Image>

                        <!-- Radar Site Marker -->
                        <Canvas>
                            <Ellipse Width="10" Height="10"
                                   Fill="Red"
                                   Stroke="White"
                                   StrokeThickness="2"
                                   Canvas.Left="512"
                                   Canvas.Top="512"/>
                        </Canvas>

                        <!-- ONW Logo Overlay (Top Left) -->
                        <Image Source="/Assets/ONW_Logo.png"
                             Width="200"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Margin="20"
                             Opacity="0.9"/>

                        <!-- Timestamp Overlay (Bottom Right) -->
                        <Border Background="#CC000000"
                              CornerRadius="5"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              Margin="20"
                              Padding="15,8">
                            <TextBlock Text="{Binding CurrentFrame.Timestamp, StringFormat='MMM dd yyyy h:mm tt'}"
                                     Foreground="White"
                                     FontSize="16"
                                     FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <!-- Zoom Controls (Floating) -->
                <Border VerticalAlignment="Bottom"
                        HorizontalAlignment="Right"
                        Margin="20"
                        Background="#CC2D2D2D"
                        Padding="10"
                        CornerRadius="5">
                    <StackPanel>
                        <Button Content="+"
                          FontSize="20"
                          FontWeight="Bold"
                          Width="40"
                          Height="40"
                          Margin="0,0,0,5"
                          Click="ZoomIn_Click"
                          Style="{StaticResource MaterialDesignFloatingActionButton}"
                          Background="#2196F3"/>
                    <TextBlock Text="100%"
                             x:Name="ZoomLevelText"
                             Foreground="White"
                             FontWeight="SemiBold"
                             TextAlignment="Center"
                             Margin="0,5"/>
                    <Button Content="-"
                          FontSize="20"
                          FontWeight="Bold"
                          Width="40"
                          Height="40"
                          Margin="0,5,0,0"
                          Click="ZoomOut_Click"
                          Style="{StaticResource MaterialDesignFloatingActionButton}"
                          Background="#2196F3"/>
                    <Button Content="↺"
                          FontSize="18"
                          Width="40"
                          Height="40"
                          Margin="0,10,0,0"
                          Click="ResetZoom_Click"
                          Style="{StaticResource MaterialDesignFloatingActionButton}"
                          Background="#455A64"
                          ToolTip="Reset Zoom"/>
                    </StackPanel>
                </Border>

                <!-- Loading Indicator -->
                <Grid x:Name="LoadingOverlay"
                    Background="#AA000000"
                    Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center"
                              HorizontalAlignment="Center">
                        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                   Value="0"
                                   IsIndeterminate="True"
                                   Width="60"
                                   Height="60"
                                   Foreground="#2196F3"/>
                        <TextBlock Text="Loading Radar..."
                                 Foreground="White"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Margin="0,20,0,0"
                                 HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Animation Controls -->
        <Border Grid.Row="2" Background="#2D2D2D" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Play/Pause Button -->
                <Button Grid.Column="0"
                      x:Name="PlayPauseButton"
                      Width="50"
                      Height="50"
                      Style="{StaticResource MaterialDesignFloatingActionButton}"
                      Background="#4CAF50"
                      Click="PlayPause_Click"
                      Margin="0,0,15,0">
                    <materialDesign:PackIcon x:Name="PlayPauseIcon"
                                           Kind="Play"
                                           Width="24"
                                           Height="24"/>
                </Button>

                <!-- Timeline Slider -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Slider x:Name="FrameSlider"
                          Grid.Row="0"
                          Minimum="0"
                          Maximum="{Binding RadarFrames.Count, Converter={StaticResource MaxFrameConverter}}"
                          Value="{Binding CurrentFrameIndex, Mode=TwoWay}"
                          Style="{StaticResource MaterialDesignDiscreteSlider}"
                          TickFrequency="1"
                          Foreground="#2196F3"
                          Margin="0,0,0,5"/>

                    <TextBlock Grid.Row="1"
                             HorizontalAlignment="Center"
                             Foreground="White"
                             FontSize="12">
                        <Run Text="Frame "/>
                        <Run Text="{Binding CurrentFrameIndex, StringFormat={}{0:0}}"/>
                        <Run Text=" of "/>
                        <Run Text="{Binding RadarFrames.Count, StringFormat={}{0:0}}"/>
                    </TextBlock>
                </Grid>

                <!-- Animation Speed Control -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="15,0">
                    <TextBlock Text="Speed:"
                             Foreground="White"
                             FontSize="14"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center"
                             Margin="0,0,10,0"/>
                    <Slider x:Name="SpeedSlider"
                          Minimum="100"
                          Maximum="1000"
                          Value="{Binding AnimationSpeed, Mode=TwoWay}"
                          Width="150"
                          VerticalAlignment="Center"
                          Style="{StaticResource MaterialDesignDiscreteSlider}"
                          Foreground="#2196F3"
                          TickFrequency="100"/>
                    <TextBlock Text="{Binding AnimationSpeed, StringFormat={}{0:0}ms}"
                             Foreground="White"
                             FontSize="12"
                             VerticalAlignment="Center"
                             Margin="10,0,0,0"
                             MinWidth="50"/>
                </StackPanel>

                <!-- Export Button -->
                <Button Grid.Column="3"
                      Command="{Binding ExportCurrentFrameCommand}"
                      Style="{StaticResource MaterialDesignOutlinedButton}"
                      BorderBrush="White"
                      Foreground="White"
                      Height="40"
                      Padding="20,0"
                      Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Export"
                                               Width="20"
                                               Height="20"
                                               VerticalAlignment="Center"/>
                        <TextBlock Text="Export"
                                 Margin="8,0,0,0"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Converter to get max frame index (count - 1) -->
        <local:MaxFrameIndexConverter x:Key="MaxFrameConverter"/>
    </UserControl.Resources>
</UserControl>

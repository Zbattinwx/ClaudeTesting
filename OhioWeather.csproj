<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <AssemblyName>OhioWeather</AssemblyName>
    <RootNamespace>OhioNewsWeather.WeatherApp</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Ohio News and Weather</Authors>
    <Company>Ohio News and Weather</Company>
    <Product>Ohio Weather</Product>
    <Description>Professional weather application for Ohio News and Weather forecasting</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="MaterialDesignThemes" Version="4.9.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\**\*" />
    <Resource Include="Assets\**\*" />
  </ItemGroup>

</Project>
